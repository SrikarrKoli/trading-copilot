# Trading Copilot — local / Vercel env template
# Supabase project: Trading Copilot (ref ucemnqmduiwknwgvbfmc, us-east-2)
# Do NOT use Transfer Helper project itpyjvppgoabywqcgaxu.

NEXT_PUBLIC_SUPABASE_URL=https://ucemnqmduiwknwgvbfmc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Permanent owner email example: srikarrkolipaka@gmail.com (configure in deployment).
AUTH_OWNER_EMAIL=owner@example.com

# Development-only. Ignored when NODE_ENV=production or host is not loopback.
LOCAL_AUTH_BYPASS=false

# Temporary MVP unlock. When "true", treats all routes as owner-accessible without a session.
# Reversible — set false before real multi-user launch. Never leave on in production long-term.
TEMP_AUTH_UNLOCK=false

# Optional server-only market data (never expose to the browser)
TRADIER_ENVIRONMENT=production
TRADIER_ACCESS_TOKEN=your_server_only_tradier_token
